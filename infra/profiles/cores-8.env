# Perfil de 8 núcleos (ADR-0014): o layout com folga para o host, que era o padrão
# do compose antes do padrão de 4 núcleos.
#
#   0, 1   stack de observação (postgres, influxdb, grafana, renderer, telegraf,
#          nestjs-api, nextjs-web)
#   2      mosquitto-plain   (broker alvo)
#   3      mosquitto-secure  (broker de controle)
#   4, 5   attacker          (2 núcleos, ATTACKER_CPUS=2.0)
#   6, 7   folga do host (nenhum cpuset os inclui)
#
# Uso (o --env-file SUBSTITUI o .env; se você já tem um, copie estas linhas para ele):
#     docker compose --env-file infra/profiles/cores-8.env up -d
#
# Só mexe em CPU: memória, PIDs e o resto continuam nos defaults do compose.
STACK_CPUSET=0,1
BROKER_PLAIN_CPUSET=2
BROKER_SECURE_CPUSET=3
ATTACKER_CPUSET=4,5
ATTACKER_CPUS=2.0
