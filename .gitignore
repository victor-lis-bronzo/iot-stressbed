# Segredos e configuração local
.env
.env.local
.env.*.local

# Certificados TLS gerados por scripts/gen-certs.sh (nunca versionados)
# O .gitkeep faz o diretório existir no clone, com a posse do usuário: sem ele o
# Docker cria o bind mount como root:root e o gen-certs.sh não tem a quem devolver
# os arquivos (ADR-0010).
infra/mosquitto/secure/certs/*
!infra/mosquitto/secure/certs/.gitkeep

# Credenciais/ACL do broker secure geradas em runtime pelo entrypoint
infra/mosquitto/secure/auth/

# Dados persistidos pelos containers (caso volumes bind sejam usados localmente)
infra/mosquitto/*/data/
infra/mosquitto/*/log/

# Resultados brutos de experimentos
results/

# Artefatos dos scripts de análise da Fase 5 (docs/specs/data-analysis.md):
# out/run_metrics.csv, out/grafana/, out/comparison_table.{csv,md}. Mudam a cada
# rodada de experimento e nunca são versionados.
out/

# Node / Python
node_modules/
dist/
build/
.next/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editores / SO
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
