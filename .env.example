# =========================================================================== #
# IoT StressBed — variáveis de ambiente
# =========================================================================== #
#
# Copie para `.env` (gitignored) e troque TODOS os valores marcados com
# "change-me" antes de subir a stack:
#
#     cp .env.example .env
#
# Os valores abaixo são placeholders funcionais para um laboratório isolado —
# não são seguros e não devem sair da rede bridge `stressbed-net`.
#
# Ver: docs/specs/infra-resource-isolation.md (user stories 9 e 10),
#      docs/adr/0004-cgroups-resource-isolation.md


# --------------------------------------------------------------------------- #
# Projeto
# --------------------------------------------------------------------------- #

# Prefixo dos nomes de container/rede/volume criados pelo Compose.
COMPOSE_PROJECT_NAME=stressbed


# --------------------------------------------------------------------------- #
# Brokers MQTT
# --------------------------------------------------------------------------- #

# Broker ALVO — MQTT em claro, sem autenticação. É a vulnerabilidade estudada:
# não existe credencial aqui de propósito (ver infra/mosquitto/plain/mosquitto.conf).
MQTT_PLAIN_PORT=1883

# Broker de CONTROLE — MQTTS (TLS) com usuário/senha e ACL.
MQTT_SECURE_PORT=8883
MQTT_SECURE_USERNAME=stressbed
# Só [A-Za-z0-9_.-] no usuário: ele é interpolado na ACL pelo entrypoint.
MQTT_SECURE_PASSWORD=change-me-mqtt-secure

# Antes do primeiro `docker compose up mosquitto-secure`, rode:
#     ./scripts/gen-certs.sh
# Para que o ESP32 alcance o broker secure pelo IP da LAN, gere os certificados
# incluindo esse IP no SAN:
#     CERT_EXTRA_SAN="IP:192.168.0.42" ./scripts/gen-certs.sh --force


# --------------------------------------------------------------------------- #
# PostgreSQL — estado da aplicação (usuários, sensores, metadados de run)
# NUNCA telemetria (ADR-0001).
# --------------------------------------------------------------------------- #

POSTGRES_USER=stressbed
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=stressbed
POSTGRES_PORT=5432


# --------------------------------------------------------------------------- #
# InfluxDB 2.x — série temporal (telemetria + broker_metrics)
# --------------------------------------------------------------------------- #

INFLUXDB_PORT=8086

# Usadas apenas no bootstrap do container (DOCKER_INFLUXDB_INIT_MODE=setup).
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-influx-admin

# Token de admin criado no bootstrap. É o mesmo token usado por telegraf (escrita)
# e por Grafana/NestJS (leitura). Gere um valor aleatório longo, ex:
#     openssl rand -hex 32
INFLUXDB_TOKEN=change-me-influx-token
INFLUXDB_ORG=stressbed
INFLUXDB_BUCKET=stressbed

# Retenção do bucket: 0s = infinita (dados de IC não devem expirar no meio da
# análise). Use ex. 30d se o disco for apertado.
INFLUXDB_RETENTION=0s


# --------------------------------------------------------------------------- #
# Grafana
# --------------------------------------------------------------------------- #

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana


# --------------------------------------------------------------------------- #
# Telegraf — coletor de métricas de container (ADR-0003)
# Caminho INDEPENDENTE do nestjs-api: telegraf lê os cgroups dos containers via
# socket do Docker e escreve direto no InfluxDB. Nunca deve depender do backend.
# --------------------------------------------------------------------------- #

# Intervalo de coleta. 5s dá resolução suficiente para ver a curva de degradação
# de um flood sem inflar demais o volume de pontos.
TELEGRAF_INTERVAL=5s

# Caminho do socket do Docker no HOST.
#   Linux / Docker Desktop (WSL2, macOS): /var/run/docker.sock
TELEGRAF_DOCKER_SOCK=/var/run/docker.sock

# GID do grupo `docker` no host — o telegraf precisa dele para ler o socket.
# Linux:   stat -c '%g' /var/run/docker.sock
# Docker Desktop (WSL2/macOS): o socket costuma ser root:root, use 0.
TELEGRAF_DOCKER_GID=0

# Tag `run_id` aplicada aos pontos de broker_metrics. Fica "none" fora de um
# experimento; scripts/run-experiment.sh exporta o run_id real da run ativa
# antes de recriar o container do telegraf.
RUN_ID=none


# =========================================================================== #
# ISOLAMENTO DE RECURSOS (ADR-0004) — requisito não-funcional mais crítico
# do projeto. Sem estes limites, um flood do Track B trava a máquina inteira.
# =========================================================================== #
#
# Os defaults abaixo assumem um host de 8 núcleos (0-7) e dividem assim:
#
#   0, 1     host + Docker daemon + stack de observação
#            (postgres, influxdb, grafana, telegraf, e depois nestjs-api/web)
#   2        mosquitto-plain   (broker alvo)
#   3        mosquitto-secure  (broker de controle)
#   4, 5     attacker          (reservado — serviço só chega na Fase 3)
#   6, 7     folga do host (mantém a máquina responsiva sob ataque)
#
# Os núcleos 0-1 e 6-7 ficam RESERVADOS por construção: nenhum cpuset de broker
# ou atacante os inclui. É isso que garante que Grafana/InfluxDB continuem
# coletando enquanto o broker está saturado (user story 5 da spec).
#
# Em host com MENOS núcleos, reescreva os cpusets mantendo a invariante:
# broker, atacante e stack de observação NUNCA compartilham núcleo.
#   4 núcleos:  STACK=0  PLAIN=1  SECURE=1  ATTACKER=2..3  (3 fica de folga)
#   2 núcleos:  não há isolamento real — não rode o Track B nessa máquina.
#
# Confira quantos núcleos você tem:  nproc  (Linux)  /  docker info | grep CPUs

# --- Stack de observação: fixada nos núcleos reservados ------------------- #
# Pinar a stack (e não só o broker) é o que torna a reserva real: sem isto, o
# Docker deixaria postgres/influxdb/grafana migrarem para os núcleos do broker
# e contaminarem a medição.
STACK_CPUSET=0,1

# --- mosquitto-plain (alvo) ----------------------------------------------- #
BROKER_PLAIN_CPUSET=2
# Teto de CPU (1.0 = um núcleo inteiro). Deve ser <= nº de núcleos do cpuset.
BROKER_PLAIN_CPUS=1.0
# Memória. BROKER_PLAIN_MEMSWAP DEVE ser igual a BROKER_PLAIN_MEMORY: isso
# elimina o colchão de swap e torna o ponto de OOM determinístico
# (user story 3 da spec). Nunca deixe o memswap maior.
BROKER_PLAIN_MEMORY=256m
BROKER_PLAIN_MEMSWAP=256m
# Teto de processos/threads: contém fork/thread bomb induzida por connection
# flood antes que ela consuma os PIDs do host.
BROKER_PLAIN_PIDS=512

# --- mosquitto-secure (controle) ------------------------------------------ #
# Mesmos valores do broker plain, de propósito: se o controle tivesse mais
# recurso que o alvo, a comparação plain vs secure mediria a diferença de
# hardware em vez do efeito de TLS+auth.
BROKER_SECURE_CPUSET=3
BROKER_SECURE_CPUS=1.0
BROKER_SECURE_MEMORY=256m
BROKER_SECURE_MEMSWAP=256m
BROKER_SECURE_PIDS=512

# --- attacker (Fase 3 — serviço ainda não existe no compose) -------------- #
# Documentado desde já para que os núcleos 4-5 fiquem visivelmente alocados e
# ninguém os entregue ao broker por engano.
ATTACKER_CPUSET=4,5
ATTACKER_CPUS=2.0
ATTACKER_MEMORY=512m
ATTACKER_MEMSWAP=512m
ATTACKER_PIDS=2048


# --------------------------------------------------------------------------- #
# Backend / frontend (Fases 1+ — serviços ainda não definidos no compose)
# --------------------------------------------------------------------------- #

# Segredo de assinatura do JWT (ADR-0005: todas as rotas do dashboard exigem
# autenticação). Gere com: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
