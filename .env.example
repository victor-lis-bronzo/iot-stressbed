# IoT StressBed — variáveis de ambiente.
#
# OPCIONAL (ADR-0008): o docker-compose.yml já tem defaults de desenvolvimento
# para todas as variáveis abaixo — `docker compose up` funciona sem este
# arquivo. Copie e edite só se quiser sobrescrever algum valor:
#
#     cp .env.example .env
#
# Se copiar, troque os valores marcados com "change-me" antes de expor a stack
# além do laboratório local. Os placeholders abaixo (aqui e os defaults do
# compose) são funcionais mas inseguros: valem só para um ambiente de
# pesquisa isolado, atrás da bridge `stressbed-net`.
#
# Ver: docs/specs/infra-resource-isolation.md (user stories 9 e 10),
#      docs/adr/0004-cgroups-resource-isolation.md,
#      docs/adr/0008-single-command-bootstrap.md


# --- Projeto -------------------------------------------------------------- #

COMPOSE_PROJECT_NAME=stressbed


# --- Brokers MQTT --------------------------------------------------------- #

# Broker ALVO: não existe credencial aqui de propósito
# (ver infra/mosquitto/plain/mosquitto.conf).
MQTT_PLAIN_PORT=1883

MQTT_SECURE_PORT=8883
# Só [A-Za-z0-9_.-] no usuário: ele é interpolado na ACL pelo entrypoint.
MQTT_SECURE_USERNAME=stressbed
MQTT_SECURE_PASSWORD=change-me-mqtt-secure

# O broker secure exige certificados; gere-os antes de subi-lo:
#     ./scripts/gen-certs.sh
# Para que o ESP32 o alcance pelo IP da LAN, esse IP tem que estar no SAN:
#     CERT_EXTRA_SAN="IP:192.168.0.42" ./scripts/gen-certs.sh --force


# --- Sensor mock: publisher de telemetria simulada --------------------------#

MOCK_SENSOR_ID=sensor-mock-01
MOCK_SENSOR_INTERVAL=2


# --- PostgreSQL: estado da aplicação, nunca telemetria (ADR-0001) --------- #

POSTGRES_USER=stressbed
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=stressbed
POSTGRES_PORT=5432


# --- InfluxDB 2.x: série temporal ----------------------------------------- #

INFLUXDB_PORT=8086

# Usadas apenas no bootstrap do container (DOCKER_INFLUXDB_INIT_MODE=setup).
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-influx-admin

# Token de admin criado no bootstrap, usado por telegraf (escrita) e por
# Grafana/NestJS (leitura). Gere com: openssl rand -hex 32
INFLUXDB_TOKEN=change-me-influx-token
INFLUXDB_ORG=stressbed
INFLUXDB_BUCKET=stressbed

# 0s = retenção infinita: dados de IC não devem expirar no meio da análise.
INFLUXDB_RETENTION=0s


# --- Grafana -------------------------------------------------------------- #

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Token de service account do Grafana (API key de leitura), usado pelos
# scripts de análise da Fase 5 (docs/specs/data-analysis.md, Entregável 2 —
# scripts/analysis/export_grafana.sh) para chamar o endpoint de renderização
# HTTP `/render/d-solo/...`. Mesmo padrão de token nomeado por serviço já
# usado para INFLUXDB_TOKEN acima — não é consumido pelo docker-compose.yml
# em si, só pelos scripts rodados fora do Compose. Gere em Grafana >
# Administration > Service accounts (permissão de leitura basta; não use o
# token de admin do Grafana aqui).
GRAFANA_TOKEN=change-me-grafana-token

# Renderização de imagem (#31). O export_grafana.sh renderiza os 4 painéis em
# paralelo; estas vars tunam o renderer e o Grafana. Todas têm default no
# docker-compose.yml — só mexa se o cpuset do renderer tiver poucos núcleos
# (reduza RENDERER_MAX_CONCURRENCY) ou para apertar/afrouxar a vazão.
GRAFANA_RENDER_CONCURRENCY=8
RENDERER_MODE=clustered
RENDERER_CLUSTERING_MODE=browser
RENDERER_MAX_CONCURRENCY=4

# Knobs lidos só por scripts/analysis/export_grafana.sh (fora do Compose):
# concorrência dos renders, escala/timeout do render e teto do curl.
RENDER_CONCURRENCY=4
# RENDER_SCALE=1
# RENDER_TIMEOUT=60
CURL_MAX_TIME=120


# --- Telegraf: coletor independente do backend (ADR-0003) ----------------- #

# 5s dá resolução para ver a curva de degradação de um flood sem inflar o
# volume de pontos.
TELEGRAF_INTERVAL=5s

TELEGRAF_DOCKER_SOCK=/var/run/docker.sock

# Usuário do processo telegraf. O default (0:0, root DENTRO do container, com o
# socket montado read-only) funciona em qualquer host sem descobrir GID
# (ADR-0010). Para o modo menos privilegiado, descomente e use o GID do socket:
#     stat -c '%g' /var/run/docker.sock
# TELEGRAF_USER=telegraf:999


# =========================================================================== #
# ISOLAMENTO DE RECURSOS (ADR-0004, ADR-0014) — sem estes limites, um flood do
# Track B trava a máquina inteira.
#
# Os defaults do compose assumem um host de 4 NÚCLEOS (0-3), o piso comum, para
# `docker compose up` funcionar sem `.env`:
#
#   0   stack de observação (postgres, influxdb, grafana, renderer, telegraf,
#       nestjs-api, nextjs-web) — o host e o Docker daemon não são pinados
#   1   mosquitto-plain   (broker alvo)
#   2   mosquitto-secure  (broker de controle)
#   3   attacker          (1 núcleo, ATTACKER_CPUS=1.0)
#
# Nenhum cpuset de broker ou atacante inclui o núcleo da stack: é isso que mantém
# Grafana/InfluxDB coletando enquanto o broker está saturado (user story 5 da
# spec). Os dois brokers ficam em núcleos DISTINTOS de propósito: dividir um núcleo
# faria a comparação plain vs secure medir contenção em vez de TLS+auth.
#
# Com 4 núcleos o host não tem folga: durante um Track B pesado a máquina pode
# ficar menos responsiva, e a stack inteira divide 1 núcleo.
#
# Host de 8 NÚCLEOS: use o perfil pronto (stack 0,1 | plain 2 | secure 3 |
# attacker 4,5, folga do host em 6,7):
#     docker compose --env-file infra/profiles/cores-8.env up -d
# (o --env-file substitui o .env; se você já tem um, copie as linhas do perfil)
#
# Host com MENOS de 4 núcleos: o Docker recusa o `up` (cpuset inexistente).
# Reescreva os cpusets mantendo a invariante de que broker, atacante e stack nunca
# compartilham núcleo — com 2 núcleos isso não é possível: não há isolamento real,
# não rode o Track B nessa máquina.
#
# Confira quantos núcleos você tem:  nproc  (Linux)  /  docker info | grep CPUs
# =========================================================================== #

# Pinar a stack de observação (e não só o broker) é o que torna a reserva real:
# sem isto o Docker deixaria postgres/influxdb/grafana migrarem para os núcleos
# do broker e contaminarem a medição.
STACK_CPUSET=0

BROKER_PLAIN_CPUSET=1
# Teto de CPU (1.0 = um núcleo inteiro). Deve ser <= nº de núcleos do cpuset.
BROKER_PLAIN_CPUS=1.0
# MEMSWAP DEVE ser igual a MEMORY: isso elimina o colchão de swap e torna o
# ponto de OOM determinístico (user story 3). Nunca deixe o memswap maior.
BROKER_PLAIN_MEMORY=256m
BROKER_PLAIN_MEMSWAP=256m
# Contém fork/thread bomb induzida por connection flood antes que ela consuma
# os PIDs do host.
BROKER_PLAIN_PIDS=512

# Mesmos valores do broker plain, de propósito: se o controle tivesse mais
# recurso que o alvo, a comparação plain vs secure mediria a diferença de
# hardware em vez do efeito de TLS+auth.
BROKER_SECURE_CPUSET=2
BROKER_SECURE_CPUS=1.0
BROKER_SECURE_MEMORY=256m
BROKER_SECURE_MEMSWAP=256m
BROKER_SECURE_PIDS=512

# O atacante tem o núcleo 3 só para ele. Roteiro completo em
# docs/specs/attacker-resource-limits.md.
ATTACKER_CPUSET=3
ATTACKER_CPUS=1.0
ATTACKER_MEMORY=512m
ATTACKER_MEMSWAP=512m
ATTACKER_PIDS=2048


# --- Backend / frontend ---------------------------------------------------- #
#
# Containerizados desde o ADR-0008 (serviços nestjs-api/nextjs-web no
# docker-compose.yml, que já define POSTGRES_HOST=postgres e
# INFLUXDB_URL=http://influxdb:8086 diretamente). As variáveis abaixo só
# importam se você rodar apps/api ou apps/web FORA do Docker (npm run dev) —
# nesse caso volte POSTGRES_HOST/INFLUXDB_URL para localhost, como já está.

# Todas as rotas do dashboard exigem autenticação (ADR-0005).
# Gere com: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=12h

# Runner HTTP do container `attacker`, que o api chama para disparar ataques
# (ADR-0012). Só existe na rede do compose; o compose já define este valor.
# ATTACKER_RUNNER_URL=http://attacker:8080

# Porta HTTP do backend NestJS (apps/api).
API_PORT=3000

# Porta HTTP do frontend Next.js (apps/web).
WEB_PORT=3002

# Auth.js (NextAuth v5) usado pelo dashboard (ADR-0005).
# Gere NEXTAUTH_SECRET com: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=change-me-nextauth-secret
# Necessário porque o nextjs-web roda atrás de porta mapeada (não é uma
# plataforma "conhecida" tipo Vercel) — sem isto o Auth.js recusa toda
# requisição com "UntrustedHost". NEXTAUTH_URL já fixa o host esperado.
AUTH_TRUST_HOST=true

# URL do backend vista de DENTRO de outro container (usada só pelo authorize()
# do NextAuth, que roda server-side no próprio nextjs-web). Diferente de
# NEXT_PUBLIC_API_URL, que é vista pelo browser via porta publicada no host.
API_INTERNAL_URL=http://nestjs-api:3000

# Usuário administrador semeado no bootstrap do backend, se ambos definidos.
# Sem eles, nenhum usuário é criado automaticamente (crie via seed manual).
AUTH_ADMIN_EMAIL=admin@stressbed.com
AUTH_ADMIN_PASSWORD=@admin123

# Host do Postgres visto pelo backend. `localhost` ao rodar o NestJS fora do
# Compose; `postgres` (nome do serviço) ao rodar o backend como container
# (já é o default usado pelo serviço nestjs-api no compose).
POSTGRES_HOST=localhost

# URL do InfluxDB vista pelo backend (mesma lógica de host acima).
INFLUXDB_URL=http://localhost:8086


# --- Módulo capture (subscriber malicioso nos dois brokers) --------------- #
#
# capture NÃO tem lógica condicional plain/secure: a diferença é só esta config
# (ADR-0002, spec capture-module.md). As DUAS instâncias sobem juntas no boot —
# uma por broker — porque o dashboard mostra plain e secure lado a lado na mesma
# janela (spec frontend-dashboard.md, user story 2). Cada instância taggeia o
# que grava/emite com o seu `broker`, e é por essa tag que o frontend separa os
# dois streams.

# Tópico assinado por ambas — sempre `#` no baseline (demonstra auditoria
# irrestrita). As aspas são obrigatórias: sem elas o dotenv lê o `#` como
# início de comentário e o valor chega vazio ao backend.
CAPTURE_TOPIC="#"
# false desliga as conexões MQTT das duas instâncias (útil para subir o backend
# sem broker vivo).
CAPTURE_ENABLED=true

# Broker ALVO: sem TLS, sem credencial (é a vulnerabilidade sob estudo).
CAPTURE_PLAIN_MQTT_HOST=localhost
CAPTURE_PLAIN_MQTT_PORT=1883
CAPTURE_PLAIN_MQTT_TLS=false

# Broker de CONTROLE: mTLS + senha (ADR-0007). As duas camadas são obrigatórias;
# sem certificado de cliente o handshake TLS nem chega ao CONNECT.
CAPTURE_SECURE_MQTT_HOST=localhost
CAPTURE_SECURE_MQTT_PORT=8883
CAPTURE_SECURE_MQTT_TLS=true
CAPTURE_SECURE_MQTT_USERNAME=stressbed
CAPTURE_SECURE_MQTT_PASSWORD=change-me-mqtt-secure
# Caminhos resolvidos a partir do diretório de trabalho do backend (apps/api),
# não da raiz do repositório onde este arquivo mora.
CAPTURE_SECURE_MQTT_CA_PATH=../../infra/mosquitto/secure/certs/ca.crt
CAPTURE_SECURE_MQTT_CERT_PATH=../../infra/mosquitto/secure/certs/client-capture.crt
CAPTURE_SECURE_MQTT_KEY_PATH=../../infra/mosquitto/secure/certs/client-capture.key
CAPTURE_SECURE_MQTT_REJECT_UNAUTHORIZED=true
