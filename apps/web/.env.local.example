# Base URL of the NestJS backend (REST and WebSocket). Matches API_PORT in the
# repo root .env — port 3001 belongs to Grafana, not the backend.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Base URL of THIS Next.js app. The backend already owns 3000 and Grafana owns
# 3001, so the dashboard runs on 3002 (see the `dev`/`start` scripts).
NEXTAUTH_URL=http://localhost:3002

# Signs the next-auth session cookie. Generate with: openssl rand -base64 32
# Without it every protected route redirects back to /login silently.
NEXTAUTH_SECRET=change-me-nextauth-secret
