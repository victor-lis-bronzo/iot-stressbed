# Só necessário para rodar `npm run start:dev` fora do Docker — o serviço
# nestjs-api do docker-compose.yml (ADR-0008) já recebe esses valores direto
# via `environment:`, com POSTGRES_HOST=postgres e
# INFLUXDB_URL=http://influxdb:8086.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=12h
AUTH_ADMIN_EMAIL=admin@stressbed.com
AUTH_ADMIN_PASSWORD=@admin123
POSTGRES_HOST=localhost
INFLUXDB_URL=http://localhost:8086
